#Release cmake

export LANG="C.utf8"
export LC_ALL="C.utf8"
export COOL_ORA_ENABLE_ADAPTIVE_OPT="Y"
export ASETUP_PRINTLEVEL="0"
export BINARY_TAG="x86_64-el9-gcc15-opt"
export CMTCONFIG="x86_64-el9-gcc15-opt"
if [ -z "${AtlasSetup:+x}" ]; then
    export AtlasSetup="/cvmfs/atlas.cern.ch/repo/ATLASLocalRootBase/x86_64/AtlasSetup/V03-01-34/AtlasSetup"
    export AtlasSetupVersion="AtlasSetup-03-01-34"
fi

if [ -d /tmp/mondal ]; then
   export ASETUP_SYSBIN=`mktemp -d /tmp/mondal/.asetup-sysbin-XXXXXX_$$`
else
   export ASETUP_SYSBIN=`mktemp -d /mnt/nfs19/mondal/Work/Project-W-Z/MotorHead/rdf-analysis-framework/RDFAnalysisFramework/.asetup-sysbin-XXXXXX_$$`
fi
source $AtlasSetup/scripts/sys_exe-alias.sh ''
export PATH="${ASETUP_SYSBIN}:${PATH}"
if [ -n "${MAKEFLAGS:+x}" ]; then
    asetup_flags=`echo ${MAKEFLAGS} | \grep ' -l'`
    if [ -z "${asetup_flags}" ]; then
        export MAKEFLAGS="${MAKEFLAGS} -l64"
    fi
else
    export MAKEFLAGS="-j64 -l64"
fi
source /cvmfs/sft.cern.ch/lcg/releases/gcc/15.2.0-35657/x86_64-el9/setup.sh
if [ -z "${CC:+x}" ]; then
    export CC=`\env which gcc 2>/dev/null`
    [[ -z "$CC" ]] && unset CC
fi
if [ -z "${CXX:+x}" ]; then
    export CXX=`\env which g++ 2>/dev/null`
    [[ -z "$CXX" ]] && unset CXX
fi
if [ -z "${CUDAHOSTCXX:+x}" ]; then
    export CUDAHOSTCXX=`\env which g++ 2>/dev/null`
    [[ -z "$CUDAHOSTCXX" ]] && unset CUDAHOSTCXX
fi
if [ -z "${FC:+x}" ]; then
    export FC=`\env which gfortran 2>/dev/null`
    [[ -z "$FC" ]] && unset FC
fi
export CMAKE_NO_VERBOSE="1"
if [ -z "${CMAKE_BUILD_PARALLEL_LEVEL:+x}" ]; then
    export CMAKE_BUILD_PARALLEL_LEVEL="64"
fi
type lsetup &>/dev/null
if [ $? -ne 0 ]; then
   if [ -z "$ATLAS_LOCAL_ROOT_BASE" ]; then
      if [ -z "$ATLAS_SW_BASE" ]; then
         export ATLAS_SW_BASE=/cvmfs
       fi
      export ATLAS_LOCAL_ROOT_BASE=$ATLAS_SW_BASE/atlas.cern.ch/repo/ATLASLocalRootBase
   fi
   source ${ATLAS_LOCAL_ROOT_BASE}/user/atlasLocalSetup.sh --quiet
fi
source $ATLAS_LOCAL_ROOT_BASE/packageSetups/localSetup.sh --quiet "cmake 4.2.1"
export FRONTIER_SERVER="(serverurl=http://atlasfrontier-ai.cern.ch:8000/atlr)(serverurl=http://atlasfrontier1-ai.cern.ch:8000/atlr)(serverurl=http://atlasfrontier2-ai.cern.ch:8000/atlr)(proxyurl=http://squid.farm.particle.cz:3128)(proxyurl=http://v4f.hl-lhc.net:6082)"
export ATLAS_POOLCOND_PATH="/cvmfs/atlas-condb.cern.ch/repo/conditions"
export ATLAS_DB_AREA="/cvmfs/atlas.cern.ch/repo/sw/database"
export DBRELEASE_OVERRIDE="current"
export AtlasVersion="25.0.69"
export AtlasProject="Athena"
export AtlasBaseDir="/cvmfs/atlas.cern.ch/repo/sw/software/25.0"
export ATLAS_RELEASE_BASE="/cvmfs/atlas.cern.ch/repo/sw/software/25.0"
export AtlasBuildBranch="25.0"
export AtlasArea="/cvmfs/atlas.cern.ch/repo/sw/software/25.0/Athena/25.0.69"
export AtlasReleaseType="stable"
export AtlasBuildStamp="2026-07-21T2100"
export SITEROOT="/cvmfs/atlas.cern.ch/repo/sw/software/25.0"
export ATLAS_RELEASEDATA="/cvmfs/atlas.cern.ch/repo/sw/software/25.0/atlas/offline/ReleaseData"
export LCG_RELEASE_BASE="/cvmfs/atlas.cern.ch/repo/sw/software/25.0/sw/lcg/releases"
unset GAUDI_ROOT
export G4PATH="/cvmfs/atlas.cern.ch/repo/sw/software/25.0/Geant4"
export TDAQ_RELEASE_BASE="/cvmfs/atlas.cern.ch/repo/sw/tdaq/offline"
source /cvmfs/atlas.cern.ch/repo/sw/software/25.0/Athena/25.0.69/InstallArea/x86_64-el9-gcc15-opt/setup.sh
asetup_status=$?
if [ ${asetup_status} -ne 0 ]; then
    \echo "AtlasSetup(ERROR): sourcing release setup script (/cvmfs/atlas.cern.ch/repo/sw/software/25.0/Athena/25.0.69/InstallArea/x86_64-el9-gcc15-opt/setup.sh) failed"
fi

# Remove paths containing non-existent CUDA installation
cuda_pattern="/cuda/13.3.1/x86_64-el9-gcc15-opt"
if [ -n "${PATH:+x}" ]; then
    cleaned_val=$(echo "${PATH}" | sed "s|/cvmfs/[^:]*${cuda_pattern}[^:]*:||g")
    export PATH="${cleaned_val}"
fi
if [ -n "${ROOT_INCLUDE_PATH:+x}" ]; then
    cleaned_val=$(echo "${ROOT_INCLUDE_PATH}" | sed "s|/cvmfs/[^:]*${cuda_pattern}[^:]*:||g")
    export ROOT_INCLUDE_PATH="${cleaned_val}"
fi
if [ -n "${LD_LIBRARY_PATH:+x}" ]; then
    non_cuda_paths=$(echo "${LD_LIBRARY_PATH}" | sed "s|/cvmfs/[^:]*${cuda_pattern}[^:]*:||g")
    export LD_LIBRARY_PATH="${non_cuda_paths}"
fi
unset CUDACXX

unset cuda_pattern cuda_paths non_cuda_paths cuda_include cleaned_val

export TestArea="/mnt/nfs19/mondal/Work/Project-W-Z/MotorHead/rdf-analysis-framework/RDFAnalysisFramework"
alias_sys_exe emacs
echo $LD_LIBRARY_PATH | grep -E "LCG_[^/:]*/curl/" >/dev/null
if [ $? -eq 0 ]; then
    alias_sys_exe_envU git
fi
\expr 1 \* 1 + 1 >/dev/null 2>&1
if [ $? -ne 0 ]; then
    echo -e '\nMaking workaround-alias for expr on this *OLD* machine'; alias_sys_exe expr
fi

#Release Summary as follows:
#Release base=/cvmfs/atlas.cern.ch/repo/sw/software/25.0
#Release project=Athena
#Release releaseNum=25.0.69
#Release asconfig=x86_64-el9-gcc15-opt

# Execute user-specified epilog

source /cvmfs/atlas.cern.ch/repo/ATLASLocalRootBase/swConfig/asetup/asetupEpilog.sh
script_status=$?
if [ ${script_status} -ne 0 ]; then
    \echo "AtlasSetup(ERROR): User-specified epilog (source /cvmfs/atlas.cern.ch/repo/ATLASLocalRootBase/swConfig/asetup/asetupEpilog.sh) reported failure (error ${script_status})"
fi
